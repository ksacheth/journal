# Production Environment Configuration
# Copy this to .env and update with your actual values

# MongoDB Connection
MONGODB_URL=mongodb://host.docker.internal:27017/journal
# Or use MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/journal

# Auth Configuration (CRITICAL - Must be the same across all services)
AUTH_SECRET=
# Generate new secret: openssl rand -base64 32

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Apple OAuth (Optional)
AUTH_APPLE_ID=your-apple-client-id
AUTH_APPLE_SECRET=your-apple-client-secret

# Production URL for NextAuth
NEXTAUTH_URL=https://journal.sachethkoushal.tech

# API Configuration
# Leave empty for relative URLs (recommended for production with Traefik)
NEXT_PUBLIC_API_URL=

# CORS Origins (comma-separated, no spaces after commas recommended)
CORS_ORIGIN=https://journal.sachethkoushal.tech,http://localhost:3000

# Redis Configuration (used by backend)
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
