# Database Configuration
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# API URL Configuration
# Use http://backend:3001 if running inside Docker Compose
# Use http://localhost:3001 if running locally outside Docker
# Use https://yourdomain.com/api for production
NEXT_PUBLIC_API_URL=http://backend:3001

# CORS Configuration
# Comma-separated list of allowed origins
# For production: https://yourdomain.com,https://www.yourdomain.com
# For local development: http://localhost:3000,http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Redis Configuration (optional - caching layer)
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true

# Cache TTL Configuration (in seconds)
# CACHE_TTL_ENTRY=3600      # Single entry cache TTL (default: 3600 = 1 hour)
# CACHE_TTL_MONTH=1800      # Monthly entries list cache TTL (default: 1800 = 30 minutes)
# CACHE_TTL_USER_ENTRIES=86400  # User entries metadata cache TTL (default: 86400 = 24 hours)

# Docker Configuration (for Linux hosts only)
# Export this before running docker compose on Linux:
# export DOCKER_GID="$(getent group docker | cut -d: -f3)"
# DOCKER_GID=
